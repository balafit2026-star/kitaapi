generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model gallery_images {
  id          String   @id @default(dbgenerated("(uuid())")) @db.Char(36)
  title       String   @db.Text
  description String   @db.Text
  url         String   @db.Text
  category    String   @db.Text
  uploaded_at DateTime @default(dbgenerated("(curdate())")) @db.Date

  @@index([category(length: 100)], map: "idx_gallery_category")
  @@index([uploaded_at], map: "idx_gallery_uploaded_at")
}

model members {
  id                  String    @id @default(dbgenerated("(uuid())")) @db.Char(36)
  confed_id           String    @db.Text
  designation         String    @db.Text
  name                String    @db.Text
  firm_name           String    @db.Text
  mobile              String    @db.Text
  is_pst              Boolean
  photo               String    @db.Text
  food_habit          String    @db.Text
  actual_dob          DateTime? @db.Date
  certificate_dob     DateTime? @db.Date
  anniversary_date    DateTime? @db.Date
  blood_group         String    @db.Text
  nominee             String    @db.Text
  nominee_dob         DateTime? @db.Date
  nominee_phone       String    @db.Text
  gstin               String    @db.Text
  office_address      String    @db.Text
  residential_address String    @db.Text
  office_since        String    @db.Text
  child1_name         String    @db.Text
  child1_dob          DateTime? @db.Date
  child2_name         String    @db.Text
  child2_dob          DateTime? @db.Date
  tshirt_size         String    @db.Text
  created_at          DateTime  @default(now()) @db.Timestamp(0)
  password            String?   @db.Text

  @@index([confed_id(length: 100)], map: "idx_members_confed_id")
  @@index([mobile(length: 100)], map: "idx_members_mobile")
  @@ignore
}
